generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authAccounts     AuthAccount[]
  sessions         Session[]
  tradingAccounts  TradingAccount[]
  brokerStatements BrokerStatementImport[]
  schwabConnection SchwabConnection?
}

model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Side {
  BUY
  SELL
  SELL_SHORT
  BUY_TO_COVER
}

enum PosEffect {
  OPEN
  CLOSE
  AUTO
}

enum Direction {
  LONG
  SHORT
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum MarketRegime {
  TRENDING_UP
  TRENDING_DOWN
  CHOPPY
}

// ─── Trading Domain ───────────────────────────────────────────────────────────

model TradingAccount {
  id              String   @id @default(cuid())
  userId          String
  name            String
  broker          String   @default("Schwab/TOS")
  currency        String   @default("USD")
  startingBalance Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploads        Upload[]
  brokerStatements BrokerStatementImport[]
  executions     Execution[]
  trades         RoundTripTrade[]
  dailySnapshots DailySnapshot[]
  journals       TradeJournal[]
  dailyReviews   DailyReview[]
  playbooks      Playbook[]
  weeklyReviews  WeeklyReview[]
  schwabConnection SchwabConnection?

  @@index([userId])
}

// Broker credentials, account hashes and pending source data are authenticated
// ciphertext. Never expose this model directly through an API response.
model SchwabConnection {
  id String @id @default(cuid())
  userId String @unique
  accountId String? @unique
  tokens String? @db.Text
  accounts String? @db.Text
  binding String? @db.Text
  oauthState String?
  oauthExpiresAt DateTime?
  refreshExpiresAt DateTime?
  preview String? @db.Text
  previewHash String?
  autoSync Boolean @default(false)
  lastAttemptAt DateTime?
  lastSyncAt DateTime?
  message String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Upload {
  id          String       @id @default(cuid())
  userId      String
  accountId   String
  fileHash    String
  fileName    String
  status      UploadStatus @default(PENDING)
  totalRows   Int          @default(0)
  newRows     Int          @default(0)
  skippedRows Int          @default(0)
  dateFrom    DateTime?
  dateTo      DateTime?
  warnings    String[]
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, fileHash])
  @@index([userId])
  @@index([accountId])
}

model BrokerStatementImport {
  id                         String               @id @default(cuid())
  userId                     String
  accountId                  String
  fileHash                   String
  fileName                   String
  totalRows                  Int
  importableTradeRows        Int                  @default(0)
  blockedTradeRows           Int                  @default(0)
  nonTradeRows               Int                  @default(0)
  positionAffectingNonTradeRows Int              @default(0)
  optionRows                 Int                  @default(0)
  skippedRows                Int                  @default(0)
  importSupported            Boolean              @default(false)
  sourceFormat               String               @default("SCHWAB_TRANSACTION_HISTORY")
  dateFrom                   DateTime?
  dateTo                     DateTime?
  // Trading-date span the statement claims to cover (TOS header "since X through Y";
  // Transaction History falls back to first/last row date). Drives day ownership
  // when statements overlap.
  coverageFrom               DateTime?            @db.Date
  coverageTo                 DateTime?            @db.Date
  // Set when the user confirms the import. Only confirmed statements feed the
  // account-level ledger; previews alone never create trades.
  confirmedAt                DateTime?
  warnings                   String[]
  blockers                   String[]
  assumptions                String[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rows    BrokerStatementRow[]
  positions BrokerStatementPosition[]
  ledgerWarnings BrokerStatementWarning[]
  roundTripTrades RoundTripTrade[]

  @@unique([accountId, fileHash])
  @@index([userId, createdAt])
  @@index([accountId, createdAt])
}

model BrokerStatementRow {
  id                          String   @id @default(cuid())
  statementImportId           String
  rowIndex                    Int
  rawDate                     String?
  parsedDate                  DateTime?
  action                      String
  symbol                      String
  description                 String
  quantityRaw                 String?
  priceRaw                    String?
  feesRaw                     String?
  amountRaw                   String?
  quantity                    Decimal? @db.Decimal(14, 4)
  price                       Decimal? @db.Decimal(14, 4)
  fees                        Decimal? @db.Decimal(14, 4)
  amount                      Decimal? @db.Decimal(16, 4)
  instrumentType              String
  actionCategory              String
  isImportTradeRow            Boolean  @default(false)
  blocksCanonicalImport       Boolean  @default(false)
  notes                       String[]
  optionUnderlying            String?
  optionExpiration            DateTime?
  optionStrike                Decimal? @db.Decimal(14, 4)
  optionType                  String?
  optionQuantityContracts     Decimal? @db.Decimal(14, 4)
  optionMultiplier            Int?
  underlyingEquivalentQty     Decimal? @db.Decimal(14, 4)
  createdAt                   DateTime @default(now())

  statementImport BrokerStatementImport @relation(fields: [statementImportId], references: [id], onDelete: Cascade)

  @@unique([statementImportId, rowIndex])
  @@index([statementImportId, action])
  @@index([statementImportId, symbol])
}

model BrokerStatementPosition {
  id                      String   @id @default(cuid())
  statementImportId       String
  instrumentKey           String
  instrumentType          String
  symbol                  String
  side                    String
  totalQty                Decimal  @db.Decimal(14, 4)
  closedQty               Decimal  @db.Decimal(14, 4)
  remainingQty            Decimal  @db.Decimal(14, 4) @default(0)
  multiplier              Int
  underlyingEquivalentQty Decimal  @db.Decimal(14, 4)
  entryPrice              Decimal  @db.Decimal(14, 4)
  exitPrice               Decimal? @db.Decimal(14, 4)
  grossPnl                Decimal? @db.Decimal(16, 4)
  totalFees               Decimal  @db.Decimal(14, 4)
  netPnl                  Decimal? @db.Decimal(16, 4)
  isOpen                  Boolean  @default(false)
  openRows                Int[]
  closeRows               Int[]
  openingActions          String[]
  closingActions          String[]
  entryTime               DateTime
  exitTime                DateTime?
  closeKind               String?
  createdAt               DateTime @default(now())

  statementImport BrokerStatementImport @relation(fields: [statementImportId], references: [id], onDelete: Cascade)
  roundTripTrades RoundTripTrade[]

  @@index([statementImportId, instrumentKey])
  @@index([statementImportId, isOpen])
}

model BrokerStatementWarning {
  id                String   @id @default(cuid())
  statementImportId String
  rowIndex          Int?
  instrumentKey     String?
  message           String
  createdAt         DateTime @default(now())

  statementImport BrokerStatementImport @relation(fields: [statementImportId], references: [id], onDelete: Cascade)

  @@index([statementImportId, rowIndex])
}

model Execution {
  id         String    @id @default(cuid())
  accountId  String
  uploadId   String?
  tradeId    String?
  execTime   DateTime  // midnight of trade date (UTC); use daySeq for intra-day ordering
  daySeq     Int       @default(0) // 0-based occurrence index within (accountId, execTime, symbol, side, qty, price) — enables cross-file dedup
  symbol     String
  side       Side
  qty        Decimal   @db.Decimal(12, 4)
  price      Decimal   @db.Decimal(12, 4)
  netPrice   Decimal   @db.Decimal(12, 4)
  commission Decimal   @db.Decimal(10, 4)
  posEffect  PosEffect
  assetType  String    @default("STOCK")
  spread     String?
  orderType  String?
  createdAt  DateTime  @default(now())

  account TradingAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trade   RoundTripTrade? @relation(fields: [tradeId], references: [id])

  @@unique([accountId, execTime, symbol, side, qty, price, daySeq])
  @@index([accountId, symbol])
  @@index([accountId, execTime])
  @@index([tradeId])
}

model RoundTripTrade {
  id              String    @id @default(cuid())
  accountId       String
  symbol          String
  instrumentType  String    @default("EQUITY")
  underlyingSymbol String?
  optionExpiration DateTime?
  optionStrike    Decimal?  @db.Decimal(14, 4)
  optionType      String?
  contractMultiplier Int?
  underlyingEquivalentQty Decimal? @db.Decimal(14, 4)
  direction       Direction
  closeKind       String?
  brokerStatementImportId String?
  brokerStatementPositionId String?

  brokerStatementImport   BrokerStatementImport?   @relation(fields: [brokerStatementImportId], references: [id], onDelete: SetNull)
  brokerStatementPosition BrokerStatementPosition? @relation(fields: [brokerStatementPositionId], references: [id], onDelete: SetNull)
  entryPrice      Decimal   @db.Decimal(12, 4)
  exitPrice       Decimal?  @db.Decimal(12, 4)
  totalQty        Decimal   @db.Decimal(12, 4)
  closedQty       Decimal   @db.Decimal(12, 4)  @default(0)
  remainingQty    Decimal   @db.Decimal(12, 4)  @default(0)
  grossPnl        Decimal?  @db.Decimal(14, 4)
  totalFees       Decimal   @db.Decimal(10, 4)  @default(0)
  netPnl          Decimal?  @db.Decimal(14, 4)
  initialRisk     Decimal?  @db.Decimal(12, 4)
  riskSource      String?                        // "USER" | "ATR"
  rMultiple       Decimal?  @db.Decimal(8, 4)
  isOpen          Boolean   @default(false)
  entryTime       DateTime
  exitTime        DateTime?
  durationSeconds Int?
  // Exchange trading dates of the first open / last close. entryTime/exitTime
  // order events and may fall on another UTC date (an expiration is placed at
  // the end of its day; a winter after-hours fill is past UTC midnight), so
  // daily P&L, snapshots and day-of-week analytics bucket by these.
  entryTradingDate DateTime? @db.Date
  exitTradingDate  DateTime? @db.Date
  // Stable identity of the ledger input that opened this trade: "<statementId>:<rowIndex>"
  // or "exec:<executionId>". Rebuilds use it to carry tags/notes to the same trade.
  sourceKey       String?
  tags            String[]
  notes           String?   @db.Text
  notesUpdatedAt  DateTime?
  // The journal is durable: rebuilding/deleting a trade never deletes user writing.
  journalId       String? @unique
  journal         TradeJournal? @relation(fields: [journalId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account        TradingAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  executions     Execution[]
  fills          TradeFill[]
  context        TradeContext?
  classification TradeClassification?

  @@index([accountId, symbol])
  @@index([accountId, entryTime])
  @@index([accountId, isOpen])
}

/// Fills (and lifecycle events) the account ledger applied to a trade, written
/// by every ledger rebuild. qty/fees are the portion attributed to this trade,
/// so a reversal row split across two trades appears once in each. Charts and
/// the setup classifier read fills from here.
model TradeFill {
  id        String    @id @default(cuid())
  tradeId   String
  seq       Int       // order within the trade: opens first, then closes
  time      DateTime
  kind      String    // OPEN | CLOSE | EXPIRATION | TRANSFER_IN | TRANSFER_OUT
  posEffect PosEffect
  side      Side
  qty       Decimal   @db.Decimal(14, 4)
  price     Decimal?  @db.Decimal(14, 4)
  fees      Decimal   @db.Decimal(10, 4) @default(0)

  trade RoundTripTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId, seq])
}

model TradeContext {
  id                  String        @id @default(cuid())
  tradeId             String        @unique
  sma20               Decimal       @db.Decimal(12, 4)
  sma50               Decimal       @db.Decimal(12, 4)
  sma200              Decimal       @db.Decimal(12, 4)
  ema20               Decimal       @db.Decimal(12, 4)
  atr14               Decimal       @db.Decimal(12, 4)
  rsi14               Decimal       @db.Decimal(12, 4)
  adx14               Decimal       @db.Decimal(12, 4)
  bbUpper             Decimal       @db.Decimal(12, 4)
  bbLower             Decimal       @db.Decimal(12, 4)
  highN52w            Decimal       @db.Decimal(12, 4)
  lowN52w             Decimal       @db.Decimal(12, 4)
  prevClose           Decimal       @db.Decimal(12, 4)
  gapPercent          Decimal       @db.Decimal(8, 4)
  nearestEarningsDate DateTime?
  daysToEarnings      Int?
  marketRegime        MarketRegime?
  enrichedAt          DateTime      @default(now())

  trade RoundTripTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model TradeClassification {
  id             String   @id @default(cuid())
  tradeId        String   @unique
  setup          String
  confidence     Int
  secondarySetup String?
  scoreBreakdown Json
  classifiedAt   DateTime @default(now())

  trade RoundTripTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model DailySnapshot {
  id            String   @id @default(cuid())
  accountId     String
  date          DateTime @db.Date
  dailyPnl      Decimal  @db.Decimal(14, 4)
  cumulativePnl Decimal  @db.Decimal(14, 4)
  peakEquity    Decimal  @db.Decimal(14, 4)
  drawdown      Decimal  @db.Decimal(14, 4)
  maxDrawdown   Decimal  @db.Decimal(14, 4)
  winCount      Int      @default(0)
  lossCount     Int      @default(0)
  tradeCount    Int      @default(0)
  grossPnl      Decimal  @db.Decimal(14, 4)
  totalFees     Decimal  @db.Decimal(10, 4)

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([accountId, date])
}

model MarketDataCache {
  id        String   @id @default(cuid())
  symbol    String
  date      DateTime // candle timestamp (daily at session date, intraday at exact candle time UTC)
  timeframe String
  open      Decimal  @db.Decimal(12, 4)
  high      Decimal  @db.Decimal(12, 4)
  low       Decimal  @db.Decimal(12, 4)
  close     Decimal  @db.Decimal(12, 4)
  volume    BigInt
  fetchedAt DateTime @default(now())

  @@unique([symbol, date, timeframe])
  @@index([symbol, timeframe, date])
}

/// User-authored review, retained independently of derived/rebuilt trades.
/// Snapshot identity keeps unmatched reviews discoverable after a broker correction.
model TradeJournal {
  id              String @id @default(cuid())
  accountId       String
  symbol          String
  direction       String
  entryTime       DateTime
  entryTradingDate DateTime @db.Date
  thesis          String @default("") @db.Text
  setup           String @default("")
  plannedStop     Decimal? @db.Decimal(12, 4)
  mistakes        String[]
  lesson          String @default("") @db.Text
  notes           String @default("") @db.Text
  tags            String[]
  planAdherence   String @default("UNASSESSED")
  reviewedAt      DateTime?
  version         Int @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trade           RoundTripTrade?
  attachments     JournalAttachment[]
  playbookLink    PlaybookJournal?
  @@index([accountId, entryTradingDate])
}

model JournalAttachment {
  id          String @id @default(cuid())
  journalId   String
  contentType String
  byteSize    Int
  data        Bytes
  createdAt   DateTime @default(now())
  journal     TradeJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  @@index([journalId])
}

model DailyReview {
  id          String @id @default(cuid())
  accountId   String
  tradingDate DateTime @db.Date
  whatWorked  String @default("") @db.Text
  toImprove   String @default("") @db.Text
  nextFocus   String @default("") @db.Text
  notes       String @default("") @db.Text
  reviewedAt  DateTime?
  version     Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  account     TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, tradingDate])
}

model Playbook {
  id            String @id @default(cuid())
  accountId     String
  name          String
  description   String @default("") @db.Text
  entryCriteria String @default("") @db.Text
  exitCriteria  String @default("") @db.Text
  invalidation  String @default("") @db.Text
  archived      Boolean @default(false)
  version       Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  account       TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  journals      PlaybookJournal[]
  @@index([accountId, archived])
}

model PlaybookJournal {
  id         String @id @default(cuid())
  playbookId String
  journalId  String @unique
  isExample  Boolean @default(false)
  playbook   Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  journal    TradeJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  @@index([playbookId])
}

model WeeklyReview {
  id              String @id @default(cuid())
  accountId       String
  weekStart       DateTime @db.Date
  observation     String @default("") @db.Text
  experiment      String @default("") @db.Text
  successCriteria String @default("") @db.Text
  result          String @default("") @db.Text
  version         Int @default(1)
  updatedAt       DateTime @updatedAt
  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, weekStart])
}
